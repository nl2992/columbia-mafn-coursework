#!/bin/zsh
set -u

# Finder does not inherit the interactive shell's Homebrew search path.
export PATH="/opt/homebrew/bin:/usr/local/bin:${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"

script_dir="${0:A:h}"
bundle_repo="${script_dir}/../../.."
path_file="${script_dir}/../Resources/repository-path.txt"
repo_root=""
if [[ -f "${bundle_repo}/scripts/run_rag.py" ]]; then
  repo_root="${bundle_repo}"
elif [[ -f "${path_file}" ]]; then
  configured_root="$(<"${path_file}")"
  [[ -f "${configured_root}/scripts/run_rag.py" ]] && repo_root="${configured_root}"
elif [[ -f "${HOME}/Desktop/Canvas Files/scripts/run_rag.py" ]]; then
  repo_root="${HOME}/Desktop/Canvas Files"
fi
if [[ -z "${repo_root}" ]]; then
  /usr/bin/osascript -e 'display alert "Course Archive repository not found" message "Run INSTALL ON DESKTOP.command from the pulled repository, or launch Course Archive.app from inside the repository." as critical' >/dev/null 2>&1
  exit 1
fi
cd "${repo_root}" || exit 1
mkdir -p .rag/logs

log_file="${repo_root}/.rag/logs/course-archive-app.log"
/bin/zsh "${repo_root}/START HERE - Open Course Archive.command" >> "${log_file}" 2>&1
launch_code=$?
if (( launch_code != 0 )); then
  /usr/bin/osascript -e 'display alert "Course Archive could not start" message "Open .rag/logs/course-archive-app.log in the repository for the exact error. The README contains the one-time setup steps." as critical' >/dev/null 2>&1
  /usr/bin/open "${log_file}"
fi
exit ${launch_code}
